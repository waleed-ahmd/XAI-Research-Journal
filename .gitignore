# Secrets
.env
harness/.env

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/

# Original model responses: ignored by default; preserve and explicitly include reviewed
# datasets for publication. Paid reruns cannot reproduce these responses exactly.
harness/results/raw/*.jsonl
!harness/results/raw/anthropic.jsonl
!harness/results/raw/openai.jsonl
# Publish study summaries and preserve human ratings; keep the blinding key local.
harness/results/summary/*
!harness/results/summary/.gitkeep
!harness/results/summary/metrics_summary.csv
!harness/results/summary/needs_review.csv
!harness/results/summary/accuracy.png
!harness/results/summary/flip_rates.png
!harness/results/summary/coding_sheet.csv

# BBH cache fetched from the Turpin et al. repo: regenerate with `cot-harness fetch-data`.
# harness/data/selected_questions.json IS committed (it records exactly which questions
# were used), so this only ignores the per-task raw val_data.json cache.
harness/data/bbh/

# Vs code files

.DS_Store

# LaTeX build output (CI builds the PDF)
shortpaper/*.aux
shortpaper/*.bbl
shortpaper/*.blg
shortpaper/*.fdb_latexmk
shortpaper/*.fls
shortpaper/*.log
shortpaper/*.out
shortpaper/*.synctex.gz
shortpaper/main.pdf

# Asynchronous batch manifests/input files contain full prompts and are local run artifacts.
harness/results/batches/*
!harness/results/batches/.gitkeep

# Publish the historical responses used in the combined study.
harness/results/historical/*.jsonl
!harness/results/historical/anthropic.jsonl
!harness/results/historical/openai.jsonl
